# Token from @BotFather (/newbot)
BOT_TOKEN=
# Telegram user IDs allowed to use the bot, comma-separated.
# Unknown users are logged as "rejected inline query from user id=..." — take your ID from there.
ALLOWED_USERS=
# Path to the pi binary; a bare name is looked up in PATH.
PI_BIN=pi
PI_TIMEOUT=180
# Optional overrides:
# PI_ARGS=-p --no-session --tools read,grep,find,ls
# PI_CWD=/home/you
# PI_MAX_JOBS=2
